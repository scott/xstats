# Copy to ~/.config/xstats/deploy.env (or ./.env.deploy) and chmod 600. Never commit the real file.
# Secrets do NOT go here: export BASIC_AUTH_PASSWORD in your shell when deploying.
XSTATS_HOST=203.0.113.10
XSTATS_DOMAIN=stats.example.com
XSTATS_SSH_USER=root
XSTATS_AUTH_USER=admin
SSH_KEY=$HOME/.ssh/id_ed25519
XSTATS_TOKEN_FILE=$HOME/.config/xstats/ingest_token
# Optional: tab order, first is the default account
XSTATS_ACCOUNTS=example_one,example_two
# Optional. deploy.sh writes this to /etc/xstats/env when set; omit it to keep the binary default.
# XSTATS_TZ=Europe/Berlin
# Used by snapshot/push.sh
STATS_URL=https://stats.example.com
